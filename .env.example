# API Keys
GEMINI_API_KEY=your_google_gemini_api_key_here

# LLM Settings
GEMINI_MODEL=gemini-1.5-flash

# Embedding Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Vector Store
CHROMA_PERSIST_DIR=data/chroma_db
RAG_TOP_K=5

# Database
DB_PATH=data/maintenance.db

# Memory Settings
MEMORY_MAX_TURNS=20
MEMORY_SUMMARY_THRESHOLD=15
MEMORY_MAX_CONTEXT_CHARS=3000

# Application
ENVIRONMENT=development